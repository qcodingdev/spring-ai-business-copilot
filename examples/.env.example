# Spring AI Business Copilot 环境变量示例
# 复制为 .env 并填入真实值后再执行 docker compose up。
# 切勿提交真实 API Key。

# ── 数据库 ──
POSTGRES_DB=business_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot

# 应用读取的 datasource（与上面保持一致）
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/business_copilot
SPRING_DATASOURCE_USERNAME=copilot
SPRING_DATASOURCE_PASSWORD=copilot

# ── Spring AI / OpenAI 兼容模型 ──
# 留空时 chat model 为 none，AI 功能不可用（只读查询等基础能力仍可运行）。
SPRING_AI_MODEL_CHAT=none
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-5-mini
