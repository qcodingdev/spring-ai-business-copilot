# Spring AI Business Copilot 环境变量示例
# 复制为 .env 并填入真实值后再执行 docker compose up。
# 切勿提交真实 API Key。

# ── 数据库 ──
POSTGRES_DB=business_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_HOST_PORT=5432
APP_HOST_PORT=8080
SPRING_PROFILES_ACTIVE=self-hosted

# 长期公网体验模式改为 public-demo（正式 Railway 使用 prod,public-demo），并务必替换强随机值。
# BUSINESS_COPILOT_PUBLIC_DEMO_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters
# BUSINESS_COPILOT_PUBLIC_DEMO_CLIENT_DAILY_OPERATIONS=20
# BUSINESS_COPILOT_PUBLIC_DEMO_GLOBAL_DAILY_MODEL_CALLS=500
# BUSINESS_COPILOT_PUBLIC_DEMO_MAX_CONCURRENT_EXECUTIONS=4

# 首次创建 PostgreSQL volume 时生成；V10 仅授予 6 张示例业务表 SELECT。
BUSINESS_READER_USERNAME=business_reader
BUSINESS_READER_PASSWORD=business-reader-change-me

# 应用读取的 datasource（与上面保持一致）
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/business_copilot
SPRING_DATASOURCE_USERNAME=copilot
SPRING_DATASOURCE_PASSWORD=copilot

# ── 登录与角色（共享环境部署前必须修改默认密码）──
# 正式或共享环境建议设置 SPRING_PROFILES_ACTIVE=prod；prod profile 不接受下列密码缺失。
BUSINESS_COPILOT_ADMIN_USERNAME=admin
BUSINESS_COPILOT_ADMIN_PASSWORD=admin-change-me
BUSINESS_COPILOT_OPERATOR_USERNAME=operator
BUSINESS_COPILOT_OPERATOR_PASSWORD=operator-change-me
BUSINESS_COPILOT_REVIEWER_USERNAME=reviewer
BUSINESS_COPILOT_REVIEWER_PASSWORD=reviewer-change-me

# ── 可选：Data Copilot 独立只读业务查询库 ──
# 只有配置了表级最小权限只读账号后才启用。2.0 支持 PostgreSQL/MySQL 查询目标。
BUSINESS_QUERY_DATASOURCE_ENABLED=true
BUSINESS_QUERY_DATASOURCE_URL=jdbc:postgresql://postgres:5432/business_copilot
BUSINESS_QUERY_DATASOURCE_USERNAME=business_reader
BUSINESS_QUERY_DATASOURCE_PASSWORD=business-reader-change-me
BUSINESS_QUERY_DATASOURCE_DIALECT=auto
BUSINESS_QUERY_DATASOURCE_DRIVER=org.postgresql.Driver
BUSINESS_QUERY_DATASOURCE_MAX_POOL_SIZE=5

# ── Spring AI / OpenAI 兼容模型 ──
# 默认关闭 chat model；需要 AI 功能时改为 openai 并填写 API Key。
SPRING_AI_MODEL_CHAT=none
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
SPRING_AI_OPENAI_CHAT_BASE_URL=https://api.deepseek.com
SPRING_AI_OPENAI_CHAT_API_KEY=
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-v4-flash
SPRING_AI_OPENAI_CHAT_TIMEOUT=45s

# 瞬时故障最多尝试 3 次；4xx 客户端错误不会重试。
SPRING_AI_RETRY_MAX_ATTEMPTS=3
SPRING_AI_RETRY_INITIAL_INTERVAL=500ms
SPRING_AI_RETRY_MAX_INTERVAL=2s

# 五模块共享 AI 调用保护。阈值调整前应先运行真实业务压测。
BUSINESS_COPILOT_AI_MAX_CONCURRENT_CALLS=8
BUSINESS_COPILOT_AI_ACQUIRE_TIMEOUT=2s
BUSINESS_COPILOT_AI_CIRCUIT_WINDOW_SIZE=10
BUSINESS_COPILOT_AI_CIRCUIT_MIN_CALLS=5
BUSINESS_COPILOT_AI_CIRCUIT_FAILURE_RATE=50
BUSINESS_COPILOT_AI_CIRCUIT_OPEN_DURATION=30s

# ── 知识库 Embedding ──
# Knowledge Copilot 必须单独启用 embedding，并填写 embedding 服务的 Key。
# 维度必须与模型实际输出一致；数据库列从 V17 起支持不同模型维度，无需再修改历史迁移。
SPRING_AI_MODEL_EMBEDDING=none
SPRING_AI_OPENAI_EMBEDDING_BASE_URL=https://api.openai.com
SPRING_AI_OPENAI_EMBEDDING_API_KEY=
SPRING_AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SPRING_AI_OPENAI_EMBEDDING_DIMENSION=1536
SPRING_AI_OPENAI_EMBEDDING_TIMEOUT=30s
